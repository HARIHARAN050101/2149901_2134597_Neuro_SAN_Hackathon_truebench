# Copy this file to .env and fill in the key for whichever provider you want to use.
# The agent network's llm_config defaults to "gpt-4o" (see registries/truebench/truebench_agent_network.hocon).
# To use a different provider instead, change model_name there and set the matching key below.
# Free-tier options: https://github.com/cheahjs/free-llm-api-resources

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Required by the neuro-san server to find this repo's agent network + coded tools:
AGENT_MANIFEST_FILE=./registries/manifest.hocon
AGENT_TOOL_PATH=./coded_tools
